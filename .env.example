DB_HOST=your-aiven-host
DB_PORT=your-aiven-port
DB_NAME=defaultdb
DB_USER=your-aiven-user
DB_PASSWORD=your-aiven-password
DB_SSL_CA=/etc/secrets/ca.pem
JWT_SECRET=generate-a-random-secret-at-least-32-characters
REFRESH_TOKEN_KEY=generate-another-random-secret-at-least-32-characters
JWT_ISSUER=product-api
JWT_AUDIENCE=product-frontend
ACCESS_TOKEN_TTL=900
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=generate-with-password_hash
FRONTEND_ORIGIN=http://localhost:5173